{
  "openapi": "3.0.4",
  "info": {
    "title": "GD Tutor foundation API",
    "description": "Nonpersistent foundation only. Development diagnostics save nothing. No authentication, database, payment or storage integration yet. Responses use no-store and X-Trace-Id; errors include code and traceId extensions.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/diagnostics/delay": {
      "get": {
        "tags": [
          "DevelopmentDiagnostics"
        ],
        "summary": "Development-only sample read delayed by two seconds; cancellation is honored and nothing is saved.",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnostics/validation": {
      "post": {
        "tags": [
          "DevelopmentDiagnostics"
        ],
        "summary": "Development-only input validation demonstration; saves nothing.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationDemoRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationDemoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationDemoResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationDemoResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationDemoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnostics/failure": {
      "get": {
        "tags": [
          "DevelopmentDiagnostics"
        ],
        "summary": "Development-only controlled exception to inspect safe error handling.",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Process liveness only; no database or provider probe.",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Foundation readiness only; external dependencies are not yet integrated or verified.",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Read the nonpersistent foundation sample and UTC server time.",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "X-Trace-Id": {
                "description": "Server-generated request identifier, also present in errors and safe logs.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "required": [
          "status",
          "scope",
          "dependenciesVerified"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "dependenciesVerified": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "SystemStatusResponse": {
        "required": [
          "status",
          "apiVersion",
          "serverTime",
          "sampleLabel",
          "isDemonstration",
          "scope",
          "dependenciesVerified"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "sampleLabel": {
            "type": "string"
          },
          "isDemonstration": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          },
          "dependenciesVerified": {
            "type": "boolean"
          }
        }
      },
      "ValidationDemoRequest": {
        "required": [
          "label"
        ],
        "type": "object",
        "properties": {
          "label": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "ValidationDemoResponse": {
        "required": [
          "accepted",
          "isDemonstration"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "isDemonstration": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "DevelopmentDiagnostics"
    },
    {
      "name": "Health"
    },
    {
      "name": "System"
    }
  ]
}